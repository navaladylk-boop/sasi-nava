{
  "appId": "com.lankahr.payroll",
  "productName": "LankaHR Payroll & Attendance",
  "copyright": "Copyright © 2026 LankaHR",
  "directories": {
    "output": "dist-electron-release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "LankaHR-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LankaHR Payroll"
  }
}
